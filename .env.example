# Public AML-facing secret. Generate a long random value for deployment.
MEMORY_API_KEY=replace-me

# Supabase DEV project. A publishable/anon key is sufficient: tables are private
# and access is limited to SECURITY DEFINER RPCs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me
STORAGE_RPC_TOKEN=replace-with-a-separate-random-secret

# Alibaba Cloud Model Studio / DashScope OpenAI-compatible endpoint.
DASHSCOPE_API_KEY=replace-me
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Retrieval defaults.
SEMANTIC_CANDIDATES=200
LEXICAL_CANDIDATES=200
NEIGHBOR_ANCHORS=20
NEIGHBOR_RADIUS=1
ANSWER_TOKEN_BUDGET=100000
